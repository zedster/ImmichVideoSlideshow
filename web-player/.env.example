IMMICH_URL=http://immich:2283
IMMICH_API_KEY=your_api_key_here
MIN_DURATION=10
PRELOAD_SECONDS_BEFORE_END=4
CROSSFADE_ENABLED=true
CROSSFADE_DURATION=450
QUEUE_TARGET_SIZE=2
RANDOM_BATCH_SIZE=20
USE_SQLITE_CACHE=true
SQLITE_PATH=/var/www/html/data/videos.sqlite
SYNC_ON_STARTUP=true
SHOW_SYNC_STATUS=true
ONLY_FAVORITES=false
SHOW_QR_CODE=true
SYNC_PAGE_SIZE=200
SYNC_MAX_PAGES=200
DEBUG=false
MUTATION_TOKEN=
