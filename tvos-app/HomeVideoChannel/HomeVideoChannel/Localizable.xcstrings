    "playback.hide_forever.confirm_message" : {
      "comment" : "Warning message for hide forever action",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher? Dadurch wird das Video auch in Immich ausgeblendet. Einblenden geht nur über die Weboberfläche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure? This hides the video in Immich too. The only way to unhide it is via the web interface."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? Esto también ocultará el vídeo en Immich. La única forma de volver a mostrarlo es desde la interfaz web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr ? Cela masquera aussi la vidéo dans Immich. Le seul moyen de l’afficher à nouveau est via l’interface web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当によろしいですか？ これは Immich 側でも動画を非表示にします。再表示できるのはWeb画面からのみです。"
          }
        }
      }
    },
