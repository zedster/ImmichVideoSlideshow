    "whatsnew.2_1.item1.description" : {
      "comment" : "What's New item description",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App erhielt einen benutzerfreundlicheren Einrichtungsablauf mit QR-Hilfe, damit die Verbindung einfacher klappt, ohne alles auf dem Apple TV einzutippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app added a friendlier setup flow with QR help so it is easier to get connected without typing everything on Apple TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app añadió un proceso de configuración más sencillo con ayuda por QR para conectarte sin tener que escribirlo todo en el Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a ajouté une configuration plus simple avec aide par QR pour se connecter plus facilement sans tout saisir sur Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRヘルプ付きのより分かりやすいセットアップフローを追加し、Apple TV で長い入力をしなくても接続しやすくなりました。"
          }
        }
      }
    },
